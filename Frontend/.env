# ============================================
# ENTORNO
# ============================================
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0-dev

# ============================================
# API - DESARROLLO LOCAL
# ============================================
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=30000

# ============================================
# CARACTERÍSTICAS
# ============================================
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_MAX_UPLOAD_SIZE=10
VITE_ALLOWED_FILE_TYPES=.xlsx,.xls,.csv

# ============================================
# INTERFAZ
# ============================================
VITE_APP_NAME=Hartemania Overtime (Dev)
VITE_APP_TITLE=Sistema de Control de Horas Extras
VITE_COMPANY_NAME=Hartemania
VITE_DEFAULT_THEME=light
VITE_ITEMS_PER_PAGE=20
VITE_DATE_FORMAT=DD/MM/YYYY
VITE_TIME_FORMAT=HH:mm
VITE_DATETIME_FORMAT=DD/MM/YYYY HH:mm
VITE_CURRENCY=RD$
VITE_CURRENCY_SYMBOL=RD$

# ============================================
# DEPURACIÓN (ACTIVADO EN DESARROLLO)
# ============================================
VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=debug